#DB Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=DB_NAME
DB_USERNAME=DB_USERNAME
DB_PASSWORD=DB_PASSWORD
DB_PORT=5432


SECRET_KEY='Django_Secret_Key'
DEBUG='False'

# Every host name the app is served under. Empty means Django rejects
# every request with 400 DisallowedHost. Production must list its domain,
# e.g. multi-tenant-billing-app.duckdns.org
ALLOWED_HOSTS=localhost,127.0.0.1

# Scheme + host of every origin the app is reached through, comma-separated.
# Needed because TLS terminates at the reverse proxy, so Django cannot infer it.
CSRF_TRUSTED_ORIGINS=https://your-domain.example
